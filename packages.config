<?xml version="1.0" encoding="utf-8"?>
<!-- Boxstrapper choco manifest. Applied idempotently by Update-Box.ps1:
     choco install packages.config -y  (already-installed packages are skipped).
     Add a <package id="..." /> line for each tool you want on the box. -->
<packages>
  <package id="git" />
  <package id="git-lfs" />
  <package id="vscode" />
  <package id="7zip" />
  <package id="microsoft-windows-terminal" />
  <package id="powershell-core" />
  <package id="nssm" />
  <package id="gitea" />
  <package id="restic" />
  <package id="sqlite" />   <!-- sqlite3.exe: rebuilds the DB from gitea-db.sql on a Restore-Gitea.ps1 restore -->
  <package id="tailscale" />   <!-- joins the tailnet; `tailscale serve` publishes Gitea + Jenkins to it (Tailscale-Setup.ps1) -->
  <package id="sysinternals" />
  <package id="temurin21" />   <!-- JDK 21 for Jenkins; the jenkins package ABORTS if no JRE/JAVA_HOME is present (Update-Box section 1 installs it first) -->
  <package id="jenkins" />     <!-- installs its OWN auto-start WinSW Windows service + firewall rule; Jenkins-Setup.ps1 rebinds it loopback-only at 127.0.0.1:8080 and serves it under /jenkins -->
</packages>
