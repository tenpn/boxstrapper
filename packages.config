<?xml version="1.0" encoding="utf-8"?>
<!-- Boxstrapper choco manifest. Applied idempotently by Update-Box.ps1:
     choco install packages.config -y  (already-installed packages are skipped).
     Add a <package id="..." /> line for each tool you want on the box. -->
<packages>
  <package id="git" />
  <package id="git-lfs" />
  <package id="vscode" />
  <package id="7zip" />
  <package id="microsoft-windows-terminal" />
  <package id="powershell-core" />
  <package id="nssm" />
  <package id="gitea" />
  <package id="restic" />
  <package id="sqlite" />   <!-- sqlite3.exe: rebuilds the DB from gitea-db.sql on a Restore-Gitea.ps1 restore -->
  <package id="cloudflared" />
  <package id="sysinternals" />
</packages>
