<?xml version="1.0" encoding="utf-8"?>
<!-- Boxstrapper choco manifest. Applied idempotently by Update-Box.ps1:
     choco install packages.config -y  (already-installed packages are skipped).
     temurin21 + sysinternals are ALSO pre-installed (pinned) in Update-Box.ps1
     section 1; keep those versions in sync with the pins here. -->
<packages>
  <package id="git" version="2.55.0" />
  <package id="git-lfs" version="3.7.1" />
  <package id="vscode" version="1.126.0" />
  <package id="7zip" version="26.2.0" />
  <package id="microsoft-windows-terminal" version="1.24.11321" />
  <package id="powershell-core" version="7.6.3" />
  <package id="nssm" version="2.24.101.20180116" />
  <package id="gitea" version="1.26.2" />
  <package id="restic" version="0.19.0" />
  <package id="sqlite" version="3.53.3" />   <!-- sqlite3.exe: rebuilds the DB from gitea-db.sql on a Restore-Gitea.ps1 restore -->
  <package id="tailscale" version="1.98.4" />   <!-- Tailscale-Setup.ps1 joins the tailnet + serve-resets; Gitea-/Jenkins-Setup then publish themselves via `tailscale serve` -->
  <package id="sysinternals" version="2026.6.17" />
  <package id="temurin21" version="21.0.9.10" />   <!-- JDK 21 for Jenkins; the jenkins package ABORTS if no JRE/JAVA_HOME is present (Update-Box section 1 installs it first) -->
  <package id="jenkins" version="2.555.3" />     <!-- installs its OWN auto-start WinSW Windows service + firewall rule; Jenkins-Setup.ps1 rebinds it loopback-only at 127.0.0.1:8080 and serves it under /jenkins -->
  <package id="dotnet-8.0-sdk" version="8.0.422" />
</packages>
