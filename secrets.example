# boxstrapper secrets — copy this to secrets.ini (Update-Box.ps1 does it for you on first run),
# then paste each value after '='. No quotes, no escaping — the value is everything after the
# first '=', taken literally. Leave a value blank to skip that feature (non-fatal).
# Lines starting with '#' are comments.

# Cloudflare Tunnel connector token (remote access). Blank = no tunnel; box still works locally.
CF_TUNNEL_TOKEN=

# Healthchecks.io ping URL (dead-man's-switch heartbeat). Blank = no heartbeat.
HC_PING_URL=

# Password for the autologon account. Blank = no autologon.
AUTOLOGON_PASSWORD=

# Cloudflare R2 offsite backup (gitea dump -> restic). Leave any of the five blank to skip backups.
# R2_ACCOUNT_ID is your Cloudflare account ID; the access key id/secret come from a scoped R2 API token.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# restic repository password. KEEP A COPY OFF-BOX -- without it the backups are unrecoverable.
RESTIC_PASSWORD=
# Optional: a SEPARATE Healthchecks.io check for the backup job (distinct from HC_PING_URL). Blank = no ping.
HC_BACKUP_PING_URL=
