# boxstrapper secrets — copy this to secrets.ini (Update-Box.ps1 does it for you on first run),
# then paste each value after '='. No quotes, no escaping — the value is everything after the
# first '=', taken literally. Leave a value blank to skip that feature (non-fatal).
# Lines starting with '#' are comments.

# Cloudflare Tunnel connector token (remote access). Blank = no tunnel; box still works locally.
CF_TUNNEL_TOKEN=

# Healthchecks.io ping URL (dead-man's-switch heartbeat). Blank = no heartbeat.
HC_PING_URL=

# Password for the autologon account. Blank = no autologon.
AUTOLOGON_PASSWORD=
