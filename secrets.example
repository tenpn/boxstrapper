# boxstrapper secrets — copy this to secrets.ini (Update-Box.ps1 does it for you on first run),
# then paste each value after '='. No quotes, no escaping — the value is everything after the
# first '=', taken literally. Leave a value blank to skip that feature (non-fatal).
# Lines starting with '#' are comments.

# Tailscale auth key (remote access: joins the tailnet, then `tailscale serve` publishes Gitea on it).
# Generate at https://login.tailscale.com/admin/settings/keys (starts 'tskey-auth-'); a reusable,
# pre-approved key re-bootstraps cleanly. Also enable HTTPS Certificates + MagicDNS for the tailnet.
# Blank = no Tailscale; box still works locally.
TS_AUTHKEY=

# Healthchecks.io ping URL for the Gitea heartbeat (dead-man's-switch). Blank = no Gitea heartbeat.
HC_GITEA_PING_URL=

# Healthchecks.io ping URL for a SEPARATE Jenkins heartbeat (its own check, distinct from HC_GITEA_PING_URL).
# Blank = no Jenkins heartbeat.
HC_JENKINS_PING_URL=

# Jenkins admin account. A non-blank password SKIPS the setup wizard and provisions this user (the
# password is re-applied on every run, so secrets.ini is the source of truth -- rotate by editing here).
# Blank password = keep the interactive setup wizard (Jenkins-Setup.ps1 prints initialAdminPassword).
# JENKINS_ADMIN_USER defaults to 'admin' when blank.
JENKINS_ADMIN_USER=
JENKINS_ADMIN_PASSWORD=

# Password for the autologon account. Blank = no autologon.
AUTOLOGON_PASSWORD=

# Cloudflare R2 offsite backup via restic. The SAME bucket/repo backs up BOTH Gitea (daily) and Jenkins
# (weekly); each tags its snapshots so their retention stays independent. Leave any of the five blank to
# skip ALL backups. R2_ACCOUNT_ID is your Cloudflare account ID; the access key id/secret come from a
# scoped R2 API token.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# restic repository password. KEEP A COPY OFF-BOX -- without it the backups are unrecoverable.
RESTIC_PASSWORD=
# Optional: a SEPARATE Healthchecks.io check for the GITEA backup job (distinct from HC_GITEA_PING_URL,
# the Gitea heartbeat). Blank = no ping.
HC_BACKUP_PING_URL=
# Optional: a SEPARATE Healthchecks.io check for the JENKINS backup job (distinct from HC_JENKINS_PING_URL,
# the Jenkins heartbeat, and from HC_BACKUP_PING_URL, the Gitea backup). Blank = no ping.
HC_JENKINS_BACKUP_PING_URL=
